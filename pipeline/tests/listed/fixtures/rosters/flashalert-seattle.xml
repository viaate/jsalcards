                    <!ATTLIST emergency_report report_id CDATA #REQUIRED>
                    <!ATTLIST emergency_report operating_code CDATA #REQUIRED>
                    <!ATTLIST emergency_report transpo_code CDATA #REQUIRED>

        <!ELEMENT participants (participant_category*)>
            <!ELEMENT participant_category (org*)>
                <!ATTLIST participant_category name CDATA #REQUIRED>
                <!ELEMENT org (orgname*,orgurl*)>
                    <!ELEMENT orgurl (#PCDATA)>


{
  "name": "snowlight-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Snowlight web app",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:geo": "node scripts/build-geo.mjs",
    "perf": "node perf/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "maplibre-gl": "6.11.2",
    "pmtiles": "4.5.0",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "jsdom": "30.1.1",
    "json-schema-to-typescript": "16.0.0",
    "lighthouse": "13.5.0",
    "mapshaper": "0.7.67",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "sharp": "0.35.4",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  },
  "author": "viaate",
  "overrides": {
    "adm-zip": "0.6.1",
    "fflate": "0.8.3"
  }
}
